{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:api:core": "openapi-generator-cli generate -i ../../openapi/mediapilot-core-api.yaml -g typescript-angular -o src/app/generated/core-api --additional-properties=providedInRoot=true",
    "generate:api:analytics": "openapi-generator-cli generate -i ../../openapi//mediapilot-analytics-api.yaml -g typescript-angular -o src/app/generated/analytics-api --additional-properties=providedInRoot=true",
    "generate:api": "npm run generate:api:analytics",
    "generate:api:all": "npm run generate:api:core && npm run generate:api:analytics"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.39.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}

{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:network": "ng serve --host 0.0.0.0 --port 4200",
    "format": "prettier --write .",
    "generate:api:core": "openapi-generator-cli generate -i ../../openapi/mediapilot-core-api.yaml -g typescript-angular -o src/app/generated/core-api --additional-properties=providedInRoot=true",
    "generate:api:analytics": "openapi-generator-cli generate -i ../../openapi//mediapilot-analytics-api.yaml -g typescript-angular -o src/app/generated/analytics-api --additional-properties=providedInRoot=true",
    "generate:api": "npm run generate:api:core",
    "generate:api:all": "npm run generate:api:core && npm run generate:api:analytics"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@openapitools/openapi-generator-cli": "^2.39.1",
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
